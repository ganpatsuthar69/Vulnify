{
  "$defs": {
    "CaseComparisonResult": {
      "additionalProperties": false,
      "description": "Comparative evaluation result for a single benchmark case.",
      "properties": {
        "case_id": {
          "description": "Benchmark case ID (e.g. BM-001).",
          "title": "Case Id",
          "type": "string"
        },
        "category": {
          "description": "Benchmark category (path_exists, no_path, exposure, ranking, remediation).",
          "title": "Category",
          "type": "string"
        },
        "difficulty": {
          "description": "Case difficulty (easy, medium, hard).",
          "title": "Difficulty",
          "type": "string"
        },
        "question": {
          "description": "Benchmark question text.",
          "title": "Question",
          "type": "string"
        },
        "expected_conclusion": {
          "description": "Ground truth conclusion from US-801 dataset.",
          "title": "Expected Conclusion",
          "type": "string"
        },
        "graph_result": {
          "$ref": "#/$defs/SystemExecutionResult",
          "description": "Result from Vulnify Graph-Based Agent."
        },
        "rag_result": {
          "$ref": "#/$defs/SystemExecutionResult",
          "description": "Result from RAG Baseline."
        }
      },
      "required": [
        "case_id",
        "category",
        "difficulty",
        "question",
        "expected_conclusion",
        "graph_result",
        "rag_result"
      ],
      "title": "CaseComparisonResult",
      "type": "object"
    },
    "CategorySummaryMetrics": {
      "additionalProperties": false,
      "description": "Per-category aggregated execution metrics.",
      "properties": {
        "total_cases": {
          "title": "Total Cases",
          "type": "integer"
        },
        "graph_success_count": {
          "title": "Graph Success Count",
          "type": "integer"
        },
        "rag_success_count": {
          "title": "Rag Success Count",
          "type": "integer"
        },
        "graph_avg_duration_ms": {
          "title": "Graph Avg Duration Ms",
          "type": "number"
        },
        "rag_avg_duration_ms": {
          "title": "Rag Avg Duration Ms",
          "type": "number"
        }
      },
      "required": [
        "total_cases",
        "graph_success_count",
        "rag_success_count",
        "graph_avg_duration_ms",
        "rag_avg_duration_ms"
      ],
      "title": "CategorySummaryMetrics",
      "type": "object"
    },
    "ComparisonProtocol": {
      "additionalProperties": false,
      "description": "Detailed record of the shared experimental protocol and configuration.",
      "properties": {
        "protocol_version": {
          "default": "1.0.0",
          "description": "Protocol specification version.",
          "title": "Protocol Version",
          "type": "string"
        },
        "graph_system_name": {
          "default": "vulnify-graph-agent",
          "description": "Graph-based agent pipeline identifier.",
          "title": "Graph System Name",
          "type": "string"
        },
        "rag_system_name": {
          "default": "text-rag-baseline",
          "description": "RAG baseline pipeline identifier.",
          "title": "Rag System Name",
          "type": "string"
        },
        "shared_model": {
          "description": "Common LLM model name used by both systems (e.g. gpt-4o-mini).",
          "title": "Shared Model",
          "type": "string"
        },
        "shared_provider": {
          "description": "Common LLM provider name (e.g. auto, openai, deterministic_test).",
          "title": "Shared Provider",
          "type": "string"
        },
        "temperature": {
          "default": 0.0,
          "description": "Common temperature parameter.",
          "title": "Temperature",
          "type": "number"
        },
        "max_tokens": {
          "default": 1000,
          "description": "Maximum token generation limit.",
          "title": "Max Tokens",
          "type": "integer"
        },
        "retrieval_strategy": {
          "default": "bm25_text_chunks",
          "description": "RAG retrieval algorithm.",
          "title": "Retrieval Strategy",
          "type": "string"
        },
        "top_k_chunks": {
          "default": 5,
          "description": "Number of evidence chunks retrieved by RAG.",
          "title": "Top K Chunks",
          "type": "integer"
        }
      },
      "required": [
        "shared_model",
        "shared_provider"
      ],
      "title": "ComparisonProtocol",
      "type": "object"
    },
    "ExecutionStatus": {
      "description": "Execution status for a single system evaluation on a benchmark case.",
      "enum": [
        "success",
        "failed",
        "error",
        "skipped"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "RunSummary": {
      "additionalProperties": false,
      "description": "Overall summary metrics for the benchmark run.",
      "properties": {
        "total_cases": {
          "title": "Total Cases",
          "type": "integer"
        },
        "graph_success_count": {
          "title": "Graph Success Count",
          "type": "integer"
        },
        "rag_success_count": {
          "title": "Rag Success Count",
          "type": "integer"
        },
        "graph_error_count": {
          "title": "Graph Error Count",
          "type": "integer"
        },
        "rag_error_count": {
          "title": "Rag Error Count",
          "type": "integer"
        },
        "graph_avg_duration_ms": {
          "title": "Graph Avg Duration Ms",
          "type": "number"
        },
        "rag_avg_duration_ms": {
          "title": "Rag Avg Duration Ms",
          "type": "number"
        },
        "by_category": {
          "additionalProperties": {
            "$ref": "#/$defs/CategorySummaryMetrics"
          },
          "title": "By Category",
          "type": "object"
        }
      },
      "required": [
        "total_cases",
        "graph_success_count",
        "rag_success_count",
        "graph_error_count",
        "rag_error_count",
        "graph_avg_duration_ms",
        "rag_avg_duration_ms",
        "by_category"
      ],
      "title": "RunSummary",
      "type": "object"
    },
    "SystemExecutionResult": {
      "additionalProperties": false,
      "description": "Execution result for a single system (Graph Agent or RAG Baseline) on one case.",
      "properties": {
        "system_id": {
          "description": "Unique system identifier ('graph_agent' or 'rag_baseline').",
          "title": "System Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus",
          "description": "Outcome of the execution."
        },
        "answer": {
          "description": "Generated answer text.",
          "title": "Answer",
          "type": "string"
        },
        "evidence_references": {
          "description": "IDs or citations of evidence supplied or used.",
          "items": {
            "type": "string"
          },
          "title": "Evidence References",
          "type": "array"
        },
        "retrieval_metadata": {
          "additionalProperties": true,
          "description": "Metadata about the retrieval process (e.g. top_k, scores, tool calls).",
          "title": "Retrieval Metadata",
          "type": "object"
        },
        "duration_ms": {
          "description": "Elapsed wall-clock execution time in milliseconds.",
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "tokens_used": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reported token count if available from provider.",
          "title": "Tokens Used"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sanitized error description if execution failed.",
          "title": "Error Message"
        }
      },
      "required": [
        "system_id",
        "status",
        "answer",
        "duration_ms"
      ],
      "title": "SystemExecutionResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Top-level container for a complete benchmark comparison experiment run (US-802).",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "description": "Result JSON schema version.",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "description": "Unique run identifier (e.g. run-20261018-123456).",
      "title": "Run Id",
      "type": "string"
    },
    "dataset_version": {
      "description": "US-801 benchmark dataset version evaluated.",
      "title": "Dataset Version",
      "type": "string"
    },
    "corpus_id": {
      "description": "Approved evidence corpus snapshot ID.",
      "title": "Corpus Id",
      "type": "string"
    },
    "started_at": {
      "description": "ISO 8601 start timestamp.",
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "description": "ISO 8601 completion timestamp.",
      "title": "Completed At",
      "type": "string"
    },
    "protocol": {
      "$ref": "#/$defs/ComparisonProtocol",
      "description": "Effective comparison protocol."
    },
    "summary": {
      "$ref": "#/$defs/RunSummary",
      "description": "Aggregated summary metrics."
    },
    "cases": {
      "description": "Per-case comparative results.",
      "items": {
        "$ref": "#/$defs/CaseComparisonResult"
      },
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "dataset_version",
    "corpus_id",
    "started_at",
    "completed_at",
    "protocol",
    "summary",
    "cases"
  ],
  "title": "BenchmarkRunResult",
  "type": "object"
}
