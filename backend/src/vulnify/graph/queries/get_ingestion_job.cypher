// name: get_ingestion_job
// what it proves: retrieves an IngestionJob by id and project_id
// parameters: $project_id, $job_id
MATCH (p:Project {id: $project_id})-[:HAS_JOB]->(j:IngestionJob {id: $job_id})
RETURN j.id AS id,
       j.project_id AS project_id,
       j.job_type AS job_type,
       j.status AS status,
       j.stage AS stage,
       j.service_id AS service_id,
       j.service_name AS service_name,
       j.processed_items AS processed_items,
       j.total_items AS total_items,
       j.percentage AS percentage,
       j.discovered_items AS discovered_items,
       j.created_items AS created_items,
       j.updated_items AS updated_items,
       j.reused_items AS reused_items,
       j.skipped_items AS skipped_items,
       j.failed_items AS failed_items,
       j.error_summary AS error_summary,
       j.errors_json AS errors_json,
       j.warnings_json AS warnings_json,
       j.retry_eligible AS retry_eligible,
       j.retry_of_job_id AS retry_of_job_id,
       j.created_at AS created_at,
       j.started_at AS started_at,
       j.completed_at AS completed_at,
       j.duration_ms AS duration_ms,
       j.initiated_by AS initiated_by,
       j.filename AS filename,
       j.secondary_filename AS secondary_filename,
       j.sha256_hash AS sha256_hash,
       j.ecosystem AS ecosystem,
       j.import_method AS import_method,
       j.fidelity AS fidelity,
       j.metadata_json AS metadata_json
