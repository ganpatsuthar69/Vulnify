# OSV Advisory Integration Configuration
OSV_ENABLED=true
OSV_API_BASE_URL=https://api.osv.dev
OSV_API_TIMEOUT_SECONDS=15
OSV_API_MAX_RETRIES=3
OSV_API_BACKOFF_BASE_SECONDS=1
OSV_CACHE_TTL_SECONDS=86400
OSV_MAX_CONCURRENT_REQUESTS=5
OSV_BATCH_SIZE=100

# GitHub Integration Configuration (US-503 / US-504)
# Fine-grained Personal Access Token or GitHub App token with 'Issues: Read and write' permissions
